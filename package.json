{
  "name": "digital-orrery",
  "private": true,
  "version": "0.2.0",
  "engines": { "node": ">=22.12.0" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "data": "node scripts/data.mjs",
    "data:manifest": "node pipelines/manifest.build.mjs",
    "data:publish": "node scripts/data-publish.mjs",
    "bench": "node src/physics/bench.mjs",
    "bench:attitude": "node src/physics/attitude.bench.mjs",
    "bench:frames": "node --experimental-websocket scripts/bench-frames.mjs",
    "bench:textures": "node --experimental-websocket scripts/bench-textures.mjs",
    "validate:artemis2": "node validation/artemis2.validate.mjs && node validation/artemis1.validate.mjs",
    "validate:missions": "node validation/missions.validate.mjs",
    "build:missions": "node pipelines/missions.build.mjs",
    "design:artemis2": "node validation/artemis2.design.mjs",
    "fetch:trajbrowser": "node pipelines/trajbrowser.fetch.mjs",
    "fetch:nesc": "node pipelines/nesc.fetch.mjs",
    "fetch:artemis1": "node pipelines/artemis1.fetch.mjs",
    "export:artemis1": "node pipelines/artemis1.export.mjs",
    "fetch:smallbodies": "node pipelines/smallbodies.fetch.mjs && node pipelines/smallbodies.horizons.mjs",
    "fetch:asteroids": "node pipelines/asteroids.horizons.mjs",
    "build:textures": "python3 python/textures/build_textures.py && python3 python/textures/build_ktx2.py",
    "build:smallbodies": "node pipelines/smallbodies.build.mjs",
    "build:pck": "node pipelines/pck.build.mjs",
    "fetch:moons": "node pipelines/moons.fetch.mjs",
    "fetch:irregular-moons": "node pipelines/irregularMoons.fetch.mjs",
    "build:moon-tables": "cmake -S c -B c/build -DCMAKE_BUILD_TYPE=Release && cmake --build c/build --target moon_cheb && mkdir -p public/ephemeris/moons-extra && c/build/moon_cheb public/ephemeris/moons 0.5 2000 2050 public/ephemeris/moons-extra 2020 2036",
    "fetch:flyby": "node pipelines/flyby.fetch.mjs",
    "crosscheck:artemis1": "node pipelines/artemis1.crosscheck.mjs",
    "fetch:environment": "node pipelines/environment.fetch.mjs",
    "fetch:magnetic": "node pipelines/magnetic.fetch.mjs",
    "oracle:openrocket": "node pipelines/rocket.openrocket.mjs",
    "fetch:satellites": "node pipelines/satellites.fetch.mjs",
    "fetch:satellites-horizons": "node pipelines/satellites.horizons.mjs",
    "docs:clips": "node --experimental-websocket scripts/docs-clips.mjs",
    "fetch:spacecraft": "node pipelines/spacecraft.fetch.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "7.1.0",
    "three": "^0.187.0"
  }
}
