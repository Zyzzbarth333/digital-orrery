{
  "name": "digital-orrery",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "node src/physics/bench.mjs",
    "bench:attitude": "node src/physics/attitude.bench.mjs",
    "bench:frames": "node --experimental-websocket scripts/bench-frames.mjs",
    "bench:textures": "node --experimental-websocket scripts/bench-textures.mjs",
    "validate:artemis2": "node src/physics/artemis2.validate.mjs && node src/physics/artemis1.validate.mjs",
    "validate:missions": "node src/physics/missions.validate.mjs",
    "build:missions": "node src/physics/missions.build.mjs",
    "design:artemis2": "node src/physics/artemis2.design.mjs",
    "fetch:trajbrowser": "node src/physics/trajbrowser.fetch.mjs",
    "fetch:nesc": "node src/physics/nesc.fetch.mjs",
    "fetch:artemis1": "node src/physics/artemis1.fetch.mjs",
    "export:artemis1": "node src/physics/artemis1.export.mjs",
    "fetch:smallbodies": "node src/physics/smallbodies.fetch.mjs && node src/physics/smallbodies.horizons.mjs",
    "fetch:asteroids": "node src/physics/asteroids.horizons.mjs",
    "build:textures": "python3 python/textures/build_textures.py && python3 python/textures/build_ktx2.py",
    "build:smallbodies": "node src/physics/smallbodies.build.mjs",
    "build:pck": "node src/physics/pck.build.mjs",
    "fetch:moons": "node src/physics/moons.fetch.mjs",
    "fetch:irregular-moons": "node src/physics/irregularMoons.fetch.mjs",
    "build:moon-tables": "cmake -S c -B c/build -DCMAKE_BUILD_TYPE=Release && cmake --build c/build --target moon_cheb && mkdir -p public/ephemeris/moons-extra && c/build/moon_cheb public/ephemeris/moons 0.5 2000 2050 public/ephemeris/moons-extra 2020 2036",
    "fetch:flyby": "node src/physics/flyby.fetch.mjs",
    "crosscheck:artemis1": "node src/physics/artemis1.crosscheck.mjs",
    "fetch:environment": "node src/physics/environment.fetch.mjs",
    "fetch:magnetic": "node src/physics/magnetic.fetch.mjs",
    "oracle:openrocket": "node src/physics/rocket.openrocket.mjs",
    "fetch:satellites": "node src/physics/satellites.fetch.mjs",
    "fetch:satellites-horizons": "node src/physics/satellites.horizons.mjs",
    "docs:clips": "node --experimental-websocket scripts/docs-clips.mjs",
    "fetch:spacecraft": "node src/physics/spacecraft.fetch.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "7.1.0",
    "three": "^0.187.0"
  }
}
