  "cards": [
    { "dot": "emerald", "title": "Each frame", "items": [
      "OrreryScene's rAF loop ticks SimClock, then calls Mission.frame through onFrame",
      "Mission hands every craft to KernelClient, which posts one step to kernel.worker.js",
      "The scene places bodies from the ephemeris and crafts from Mission.views()"
    ] },
    { "dot": "violet", "title": "Off the main thread", "items": [
      "kernel.worker.js steps the crafts; the journey worker flies a plan with its own kernelHost",
      "satellites.worker runs SGP4 for the catalogue",
      "Also: porkchop, passes, belt haze, gravity field and texture decode workers"
    ] },
    { "dot": "amber", "title": "Not drawn", "items": [
      "App also renders the console, plates and plotting table",
      "A flown journey becomes a craft through Mission.flyJourney",
      "Each worker loads its own DE442 tables before its first job"
    ] }
  ]
