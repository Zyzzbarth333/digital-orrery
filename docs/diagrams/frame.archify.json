  "cards": [
    { "dot": "emerald", "title": "The frame", "items": [
      "OrreryScene.frame ticks the clock, then calls Mission.frame through onFrame",
      "Mission sends each craft to KernelClient, then the scene draws Mission.views()",
      "The bodies come from the ephemeris at the clock's time"
    ] },
    { "dot": "violet", "title": "The worker", "items": [
      "KernelClient sends nothing new while a step is out",
      "The reply updates each craft's kernel state; until then each craft is carried forward",
      "With no worker, kernelHost runs the same step on the main thread"
    ] },
    { "dot": "amber", "title": "The plates", "items": [
      "SimClock tells React at most every 100 ms",
      "A plate asks for its body's state itself, at the clock's time"
    ] }
  ]
